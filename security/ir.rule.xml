<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Multi-company rule for Attendance Summary -->
        <record id="hr_payroll_attendance_summary_company_rule" model="ir.rule">
            <field name="name">Attendance Summary: Multi-company</field>
            <field name="model_id" ref="model_hr_payroll_attendance_summary"/>
            <field name="domain_force">[('employee_id.company_id', 'in', company_ids)]</field>
        </record>

        <record id="hr_payroll_attendance_period_company_rule" model="ir.rule">
            <field name="name">Attendance Period: Multi-company</field>
            <field name="model_id" ref="model_hr_payroll_attendance_period"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="hr_payroll_attendance_calc_run_company_rule" model="ir.rule">
            <field name="name">Attendance Calc Run: Multi-company</field>
            <field name="model_id" ref="model_hr_payroll_attendance_calc_run"/>
            <field name="domain_force">[('period_id.company_id', 'in', company_ids)]</field>
        </record>

        <record id="hr_payroll_attendance_summary_history_company_rule" model="ir.rule">
            <field name="name">Attendance Summary History: Multi-company</field>
            <field name="model_id" ref="model_hr_payroll_attendance_summary_history"/>
            <field name="domain_force">[('summary_id.employee_id.company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
