<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_hr_payroll_attendance_summary_tree" model="ir.ui.view">
            <field name="name">hr.payroll.attendance.summary.tree</field>
            <field name="model">hr.payroll.attendance.summary</field>
            <field name="arch" type="xml">
                <tree>
                    <header>
                        <button name="%(hr_payroll_attendance.action_hr_payroll_attendance_summary_wizard)d"
                                string="إنشاء"
                                type="action"
                                class="oe_highlight"
                                icon="fa-plus"/>
                    </header>
                    <field name="period_id" optional="show"/>
                    <field name="calc_state" widget="badge" optional="show"
                           decoration-info="calc_state == 'computed'"
                           decoration-warning="calc_state in ('stale', 'uncomputed', 'computing')"
                           decoration-danger="calc_state == 'error'"/>
                    <field name="dirty" optional="hide"/>
                    <field name="department_id" optional="hide"/>
                    <field name="work_location" string="مقر العمل"/>
                    <field name="employee_id"/>
                    <field name="date_from"/>
                    <field name="date_to"/>
                    <field name="total_lateness_hours" string="الإجمالي التأخير" widget="float_time"/>
                    <field name="total_extra_hours" string="الإجمالي الإضافي" widget="float_time"/>
                    <field name="total_absence_days"/>
                    <field name="total_leave_days"/>
                    <field name="pending_leave_days"/>
                    <field name="total_penalty_days"/>
                    <field name="forgot_attendance_count" string="نسيان البصمة"/>
                </tree>
            </field>
        </record>

        <record id="view_hr_payroll_attendance_summary_form" model="ir.ui.view">
            <field name="name">hr.payroll.attendance.summary.form</field>
            <field name="model">hr.payroll.attendance.summary</field>
            <field name="arch" type="xml">
                <form string="Attendance Summary">
                    <header>
                        <button name="%(hr_payroll_attendance.action_hr_payroll_attendance_summary_wizard)d"
                                string="إنشاء"
                                type="action"
                                class="oe_highlight"
                                icon="fa-plus"/>
                        <button name="action_recalculate"
                                string="إعادة حساب"
                                type="object"
                                class="oe_highlight"
                                icon="fa-refresh"/>
                    </header>
                    <sheet>
                        <group col="2">
                            <group>
                                <field name="employee_id"/>
                                <field name="period_id" readonly="1"/>
                                <field name="calc_state" readonly="1"/>
                                <field name="dirty" readonly="1"/>
                            </group>
                            <group>
                                <field name="department_id"/>
                                <field name="work_location"/>
                                <field name="last_run_id" readonly="1"/>
                                <field name="error_count" readonly="1"/>
                                <field name="is_computed" invisible="1"/>
                            </group>
                        </group>
                        <div class="alert alert-danger" role="alert" attrs="{'invisible': [('last_error', '=', False)]}">
                            <field name="last_error" nolabel="1"/>
                        </div>
                        <div class="alert alert-warning" role="alert" attrs="{'invisible': [('data_quality_warning', '=', False)]}">
                            <b>تحذيرات جودة البيانات:</b>
                            <field name="data_quality_warning" nolabel="1"/>
                        </div>
                        <div class="alert alert-warning" role="alert" attrs="{'invisible': [('classification_exception', '=', False)]}">
                            <b>استثناء تصنيف (يمنع اعتماد الفترة):</b>
                            <field name="classification_exception" nolabel="1"/>
                        </div>
                        <group col="2">
                            <group><field name="date_from"/></group>
                            <group><field name="date_to"/></group>
                        </group>
                        <group string="النتائج" col="2">
                            <group><field name="total_absence_days"/></group>
                            <group><field name="total_leave_days"/></group>
                            <group><field name="pending_leave_days"/></group>
                            <group><field name="total_penalty_days"/></group>
                            <group><field name="forgot_attendance_count"/></group>
                        </group>
                        <group string="التأخير والإضافي" col="2">
                            <group><field name="total_lateness_hours" widget="float_time"/></group>
                            <group><field name="total_extra_hours" widget="float_time"/></group>
                        </group>
                        <group string="تفاصيل الحساب">
                            <field name="calculation_log_html" nolabel="1" colspan="2" readonly="1"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_hr_payroll_attendance_summary_search" model="ir.ui.view">
            <field name="name">hr.payroll.attendance.summary.search</field>
            <field name="model">hr.payroll.attendance.summary</field>
            <field name="arch" type="xml">
                <search string="Search Attendance Summary">
                    <field name="employee_id" string="Employee"/>
                    <field name="department_id"/>
                    <field name="work_location"/>
                    <field name="date_from"/>
                    <field name="date_to"/>
                    <field name="period_id"/>
                    <filter string="بحاجة لإعادة حساب" name="filter_dirty" domain="[('dirty', '=', True)]"/>
                    <filter string="أخطاء" name="filter_error" domain="[('calc_state', '=', 'error')]"/>
                    <filter string="فترات فقط" name="filter_period" domain="[('period_id', '!=', False)]"/>
                    <filter string="سجلات قديمة (بلا فترة)" name="filter_legacy" domain="[('period_id', '=', False)]"/>
                    <separator/>
                    <group expand="0" string="Group By">
                        <filter string="Department" name="group_department" context="{'group_by': 'department_id'}"/>
                        <filter string="Work Location" name="group_work_location" context="{'group_by': 'work_location'}"/>
                        <filter string="Date From" name="group_date_from" context="{'group_by': 'date_from'}"/>
                        <filter string="Employee" name="group_employee" context="{'group_by': 'employee_id'}"/>
                        <filter string="الفترة" name="group_period" context="{'group_by': 'period_id'}"/>
                        <filter string="حالة الحساب" name="group_calc_state" context="{'group_by': 'calc_state'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="action_hr_payroll_attendance_summary" model="ir.actions.act_window">
            <field name="name">Attendance Summary</field>
            <field name="res_model">hr.payroll.attendance.summary</field>
            <field name="view_mode">tree,form</field>
            <field name="search_view_id" ref="view_hr_payroll_attendance_summary_search"/>
        </record>

        <record id="action_hr_payroll_attendance_summary_recalculate" model="ir.actions.server">
            <field name="name">إعادة حساب</field>
            <field name="model_id" ref="hr_payroll_attendance.model_hr_payroll_attendance_summary"/>
            <field name="binding_model_id" ref="hr_payroll_attendance.model_hr_payroll_attendance_summary"/>
            <field name="state">code</field>
            <field name="code">records.action_recalculate()</field>
        </record>

        <record id="hr_payroll_attendance_summary_view_search_inherit" model="ir.ui.view">
        <field name="name">hr.payroll.attendance.summary.view.search.inherit</field>
        <field name="model">hr.payroll.attendance.summary</field>
        <field name="inherit_id" ref="hr_payroll_attendance.view_hr_payroll_attendance_summary_search" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='employee_id']" position="attributes">
                <attribute name="filter_domain">['|', ('employee_id.name', 'ilike', self),
                    ('employee_id.pin', 'ilike', self)]</attribute>
            </xpath>
        </field>
        </record>

        <menuitem id="menu_hr_payroll_attendance_summary"
                  name="Attendance Summary"
                  parent="hr_attendance.menu_hr_attendance_root"
                  action="action_hr_payroll_attendance_summary"
                  sequence="100"/>
    </data>
</odoo>